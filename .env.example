# Copia este archivo a .env (local) o carga estas variables en Dokploy. Nunca subas valores reales.
# [OBLIGATORIA] = sin ella algo deja de funcionar. [OPCIONAL] = tiene valor por defecto o desactiva una funcion.
# Minimo para arrancar en local: APP_URL, AUTH_SECRET, AUTH_TRUST_HOST y las dos POSTGRES_*.

# --- Aplicacion ---
# [OBLIGATORIA] URL publica del entorno, sin barra final (enlaces de correos, retorno de pagos, sitemap, robots)
APP_URL=http://localhost:3000
# [OPCIONAL] production | staging | development (staging => robots.txt con Disallow: /)
APP_ENV=development
# [OBLIGATORIA] Secreto de sesion (next-auth v5). Generar con: openssl rand -base64 32. Distinto en cada entorno.
AUTH_SECRET=
# [OBLIGATORIA detras de Traefik/Dokploy] Confiar en el host del proxy
AUTH_TRUST_HOST=true

# --- Base de datos (PostgreSQL) ---
# [OPCIONAL] true => el contenedor ejecuta `prisma migrate deploy` al arrancar (recomendado en stage y produccion)
RUN_MIGRATIONS=false
# [OBLIGATORIA] Conexion a Postgres. En Dokploy ambas pueden ser la misma URL interna del servicio
POSTGRES_PRISMA_URL=postgresql://libling:libling@localhost:5432/libling
POSTGRES_URL_NON_POOLING=postgresql://libling:libling@localhost:5432/libling

# --- Fotos (S3 actual; luego Cloudflare R2) ---
# [OBLIGATORIA para subir fotos] Bucket, region y credenciales con permiso de lectura/escritura/borrado
S3_BUCKET_NAME=libling-assets
S3_REGION=eu-west-2
S3_ACCESS_KEY=
S3_SECRET_KEY=
# [OBLIGATORIA en BUILD, build arg en Dokploy] Host de las fotos permitido por next/image.
# Si se omite se usa libling-assets.s3.eu-west-2.amazonaws.com
IMAGE_HOST=libling-assets.s3.eu-west-2.amazonaws.com
# [OPCIONAL, solo R2 u otro S3 compatible] Dejar vacios para AWS S3. Para R2:
#   S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com   S3_REGION=auto
#   S3_PUBLIC_URL=https://<dominio publico del bucket>      IMAGE_HOST=<ese mismo host>
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false
# [OPCIONAL] Guarda cada original subido como respaldo privado en originals/ (false para no guardarlo).
# El prefijo originals/ NO debe ser publico en la politica del bucket.
KEEP_ORIGINALS=true

# --- Tarea diaria (papelera y conversion de fotos antiguas) ---
# [OBLIGATORIA para la purga] Secreto de al menos 16 caracteres; sin el, la ruta queda desactivada.
# Programar UNA vez al dia (Dokploy > Schedules):
#   curl -fsS -X POST -H "Authorization: Bearer $CRON_SECRET" https://libling.lu/api/cron/maintenance
# Elimina del todo lo que lleva mas de 90 dias en la papelera y convierte a WebP un lote de fotos antiguas.
CRON_SECRET=
# [OPCIONAL] Fotos antiguas convertidas por llamada diaria
CONVERT_BATCH=25

# --- Correo (SMTP) ---
# [OBLIGATORIA para formularios de contacto, recuperar contrasena y confirmaciones de pago]
SMTP_SERVER=
MAIL_USER=
MAIL_PWD=

# --- Pagos Saferpay ---
# [OBLIGATORIA para cobrar] En stage NO usar credenciales productivas (Saferpay ya no tiene entorno de pruebas)
SAFERPAY_API_CUSTOMER_ID=
SAFERPAY_API_USER=
SAFERPAY_API_PWD=
SAFERPAY_API_TERMINAL_ID=
# [OPCIONAL] Base de la API (por defecto https://www.saferpay.com). Solo para apuntar a un banco simulado en pruebas.
SAFERPAY_BASE_URL=

# --- Servicios externos ---
# [OBLIGATORIA para ver mapas] Clave de MapTiler (solo servidor)
MAP_KEY=
# [OPCIONAL] ID de Google Analytics. Solo se carga si el visitante acepta las cookies. Vacio en stage.
GOOGLE_ANALYTICS=
# [OPCIONAL] Captcha Cloudflare Turnstile. Si faltan, los formularios publicos usan solo honeypot y limite de envios.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
