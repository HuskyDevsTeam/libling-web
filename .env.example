# Copia este archivo a .env (local) o carga estas variables en Dokploy. Nunca subas valores reales.

# --- Aplicacion ---
# URL publica del entorno, sin barra final (enlaces de correos, robots, sitemap)
APP_URL=http://localhost:3000
# production | staging | development (staging => robots.txt con Disallow: /)
APP_ENV=development
# Secreto de next-auth v5: openssl rand -base64 32
AUTH_SECRET=
# Necesario detras de Traefik/Dokploy
AUTH_TRUST_HOST=true
# Secreto para firmar el JWT de recuperar contrasena (distinto en cada entorno)
AUTH_TOKEN=

# --- Base de datos (PostgreSQL) ---
# true => el contenedor ejecuta `prisma migrate deploy` al arrancar (recomendado en stage)
RUN_MIGRATIONS=false
# En Dokploy ambas pueden ser la misma URL interna del servicio Postgres
POSTGRES_PRISMA_URL=postgresql://libling:libling@localhost:5432/libling
POSTGRES_URL_NON_POOLING=postgresql://libling:libling@localhost:5432/libling

# --- Imagenes (S3 actual; luego Cloudflare R2) ---
S3_BUCKET_NAME=libling-assets
S3_REGION=eu-west-2
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Host permitido por next/image. Se lee en BUILD (build arg en Dokploy).
# Si se omite se usa libling-assets.s3.eu-west-2.amazonaws.com
IMAGE_HOST=libling-assets.s3.eu-west-2.amazonaws.com
# Cloudflare R2 (u otro S3 compatible): dejar vacios para AWS S3.
#   S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com   S3_REGION=auto
#   S3_PUBLIC_URL=https://<dominio publico del bucket>      IMAGE_HOST=<ese mismo host>
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false
# Guarda el original subido como respaldo privado en originals/ (poner false para no guardarlo).
# El prefijo originals/ NO debe ser publico en la politica del bucket.
KEEP_ORIGINALS=true

# --- Correo (SMTP) ---
SMTP_SERVER=
MAIL_USER=
MAIL_PWD=

# --- Pagos Saferpay ---
# En stage NO usar las credenciales productivas
SAFERPAY_API_CUSTOMER_ID=
SAFERPAY_API_USER=
SAFERPAY_API_PWD=
SAFERPAY_API_TERMINAL_ID=
# Base de la API (por defecto https://www.saferpay.com). Saferpay retiro su entorno de pruebas: dejar vacio en produccion.
SAFERPAY_BASE_URL=

# --- Servicios externos (solo servidor) ---
# Clave de MapTiler para el mapa
MAP_KEY=
# ID de Google Analytics (dejar vacio en stage)
GOOGLE_ANALYTICS=

# Captcha Cloudflare Turnstile (opcional). Si faltan, los formularios publicos usan solo honeypot y limite de envios.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
